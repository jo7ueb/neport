# docker-compose の postgres/migrator/backend が参照する（docker-compose.yml
# には生値を書かず、必ずここから読み込む）
POSTGRES_USER=neport
POSTGRES_PASSWORD=neport_dev_password
POSTGRES_DB=neport

# ローカルで `cargo run` する場合の接続先（上の POSTGRES_* と同じ資格情報で
# host 側公開ポート経由で接続する）
DATABASE_URL=postgres://neport:neport_dev_password@localhost:5432/neport
RUST_LOG=info
APP_ENV=development
BIND_ADDR=0.0.0.0:3000
SESSION_COOKIE_NAME=neport_session
SESSION_TTL_SECONDS=86400

# 初回起動時、usersテーブルが空の場合のみ管理者を自動作成する（任意）
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=change_me_now
#ADMIN_DISPLAY_NAME=管理者

# ログインエンドポイントのレート制限（送信元IPごと）。未設定時は
# 12秒に1トークン補充・バースト5（本番向けの控えめな既定値）。
#LOGIN_RATE_LIMIT_PER_SECOND=12
#LOGIN_RATE_LIMIT_BURST=5

# Cloud Run等、添付ファイル用のローカル永続ディスクがない環境向け（任意）。
# 設定すると添付ファイルの保存先がローカルディスクではなくこのGCSバケットに
# なる（docker composeでは未設定のままにする）。詳細は docs/CLOUD_RUN_DEPLOY.md
#GCS_BUCKET=my-neport-attachments
